<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BayMobil_Landing_page</title>
    <script type="importmap"></script>
    <link href="~/css/output.css" asp-append-version="true" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/BayMobil_Landing_page.styles.css" asp-append-version="true" />
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="/js/icon.js"></script>

</head>
<body class="scroll-smooth">
    <header class="sticky top-0 z-50 border-b border-gray-200 bg-gray-50 backdrop-blur">
        <div class="mx-auto flex h-20 items-center justify-between px-6 lg:px-8">

            <!-- Logo -->
            <a asp-controller="Home" asp-action="Index" class="flex items-center">
                <img src="/images/BayMobil_Siyah_transparent_horiz.png"
                     alt="BayMobil"
                     class="h-10 w-auto" />
            </a>

            <!-- Nav -->
            <nav id="mainNav"
                 class="absolute left-0 top-20 flex hidden w-full flex-col items-center gap-5 border-b border-gray-200 bg-gray-50 px-6 py-6 text-sm font-semibold text-gray-800
                lg:static lg:flex lg:w-auto lg:flex-row lg:gap-14 lg:justify-self-center lg:border-0 lg:bg-gray-50 lg:px-0 lg:py-0">

                <a asp-controller="Home" asp-action="Index" class="navbar-item">  Ana Sayfa  </a>
                <a asp-controller="Home" asp-action="Index" asp-fragment="ozellikler-section" class="navbar-item"> Özellikler </a>
                 <a asp-controller="Home" asp-action="Index" asp-fragment="siparis-section" class="navbar-item"> Sipariş </a>

                <a asp-controller="Home" asp-action="Iletisim" class="navbar-item"> İletişim </a>
                
                    <div id="mobileWhatsApp"
                         class="hidden px-6 pb-6 lg:hidden">
                        <a href="/WhatsAppTest/Index"
                           class="rounded-btn-green flex w-full">
                            Whatsapp Destek
                        </a>
                    </div>

                    <!-- Mobile Download Button -->
                    <div id="mobileDownload"
                         class="hidden px-6 pb-6 lg:hidden">
                        <a href="#indir"
                           class="rounded-btn-red flex w-full">
                            Hemen İndir
                        </a>
                    </div>
                
                
            </nav>

            <div> 
                <!-- Button -->
                <a href="/WhatsAppTest/Index"
                   class="rounded-btn-green hidden lg:inline-flex">
                    Whatsapp Destek
                </a>

                <!-- Button -->
                <a href="#indir"
                   class="rounded-btn-red hidden lg:inline-flex">
                    Hemen İndir
                </a>

            </div>
            
            <!-- Mobile Menu Button -->
            <button id="menuBtn"
                    type="button"
                    class="flex h-11 w-11 items-center justify-center rounded-xl border border-gray-200 text-2xl text-gray-800 no-underline lg:hidden">
                ☰
            </button>
        </div>

        
    </header>
    <div>
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer id="iletisim" class="bg-white pb-14 pt-24">
        <div class="mx-auto px-6 lg:px-18">

            <div class="grid grid-cols-2 gap-24 lg:grid-cols-4">

                <!-- Logo Alanı -->
                <div>
                    <img src="/images/BayMobil_Siyah_transparent_horiz.png"
                         alt="BayMobil"
                         class="mb-6 h-12 w-auto" />

                    <p class="w-fit text-sm leading-6 text-black">
                        BayMobil, saha satış ekipleri için geliştirilmiş
                        kapsamlı bir mobil satış ve dağıtım 
                        yönetim uygulamasıdır.
                    </p>

                    <div class="mt-8 flex gap-4">
                        <div  class="flex h-10 w-10 items-center justify-center rounded-full bg-gray-100 p-2 transition">
                            <icon name="facebook" class="h-6 w-6 text-gray-600"></icon>

                        </div>
                        <div class="flex h-10 w-10 items-center justify-center rounded-full bg-gray-100 p-2 transition">
                            <icon name="instagram" class="h-6 w-6 text-gray-600"></icon>
                        </div>
                        <div class="flex h-10 w-10 items-center justify-center rounded-full bg-gray-100 p-2">
                            <icon name="linkedin" class="h-6 w-6 text-gray-600"></icon>
                        </div>
                    </div>
                </div>

                <!-- Menü -->
                <div class="items-left">
                    <h3 class="font-black text-3xl tracking-tight text-black">Menü</h3>

                    <div class="mt-6 space-y-4 text-sm text-black">
                     
                        <div> <a asp-controller="Home" asp-action="Index" class="navbar-item"> Ana Sayfa </a></div>
                        <div> <a asp-controller="Home" asp-action="Index" asp-fragment="ozellikler-section" class="navbar-item"> Özellikler </a></div>
                        <div> <a asp-controller="Home" asp-action="Index" asp-fragment="siparis-section" class="navbar-item"> Sipariş </a></div>
                        <div> <a asp-controller="Home" asp-action="Iletisim" class="navbar-item"> İletişim </a></div>
                    </div>
                </div>

                <!-- Destek -->
                <div class="items-left">
                    <h3 class="font-black text-3xl tracking-tight text-black">Destek</h3>

                    <div class="mt-6 space-y-4 text-left text-sm text-gray-600">
                        <div> <a asp-controller="Home" asp-action="Iletisim" asp-fragment="yardim-merkezi-section" class="navbar-item"> Yardım Merkezi </a></div>
                        <div> <a asp-controller="Home" asp-action="Index" asp-fragment="kullanim-kilavuzu-section" class="navbar-item"> Kullanım Kılavuzu </a></div>
                        <div> <a asp-controller="Home" asp-action="Iletisim" asp-fragment="sss-section" class="navbar-item"> SSS </a></div>
                        <div> <a asp-controller="Home" asp-action="Gizlilik" class="navbar-item"> Gizlilik Politikası </a></div>
                    </div>
                </div>

                <!-- İletişim -->
                <div class="items-left">
                    <h3 class="font-black text-3xl tracking-tight text-black">İletişim</h3>

                    <div class="mt-6 space-y-5 text-sm text-black">
                        <div onclick="copyPhone()" class="flex items-center gap-3">
                            <icon name="phone" class="h-6 w-6 text-gray-600"></icon>
                            <span id="phone">0212 659 00 86</span>
                            <span id="phone-copy-message"
                                  class="hidden bg-white text-sm text-green-600">
                                <icon name="copy" class="h-6 w-6 text-green-600"></icon>
                                Kopyalandı
                            </span>
                        </div>

                        <div onclick="copyMail()" class="flex items-center gap-3">
                            <icon name="mail" class="h-6 w-6 text-gray-600"></icon>
                            <span id="mail">info@baymobil.com</span>
                            <span id="mail-copy-message"
                                  class="hidden bg-white text-sm text-green-600">
                                <icon name="copy" class="h-6 w-6 text-green-600"></icon>
                                Kopyalandı
                            </span>
                        </div>

                        <div class="flex items-center gap-3">
                            <icon name="location" class="h-6 w-6 text-gray-600"></icon>
                            <span>İstanbul</span>
                        </div>
                    </div>
                </div>

            </div>

        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>



<script>
    const menuBtn = document.getElementById("menuBtn");
    const mainNav = document.getElementById("mainNav");
    const mobileDownload = document.getElementById("mobileDownload");
    const mobileWhatsApp = document.getElementById("mobileWhatsApp");

    menuBtn.addEventListener("click", () => {
        mainNav.classList.toggle("hidden");
        mobileWhatsApp.classList.toggle("hidden");
        mobileDownload.classList.toggle("hidden");
        menuBtn.textContent = mainNav.classList.contains("hidden") ? "☰" : "×";
    });

    function showMessage(id) {
        const message = document.getElementById(id);
        message.classList.remove("hidden");
        setTimeout(() => {
        message.classList.add("hidden");
        }, 1500);
    }

    function copyPhone() {
        const phone = document.getElementById("phone").innerText.replace(/\s+/g, "");
        navigator.clipboard.writeText(phone);
        showMessage("phone-copy-message");
    }
    function copyMail() {
        const mail = document.getElementById("mail").innerText;
        navigator.clipboard.writeText(mail);
        showMessage("mail-copy-message");
    }


</script>