@{
    ViewData["Title"] = "Home Page";
}

<div class="bg-gray-100 p-3 text-center lg:p-10">

    @*
        Saha satış yönetim sistemi div
    *@
    <section class="relative min-h-screen overflow-hidden py-3">
        <div class="mx-auto grid w-full grid-cols-1 items-center justify-between gap-10 px-5 pt-3 lg:grid-cols-[2fr_3fr] lg:px-10 lg:pt-10">

            <!-- Sol Alan -->
            <div class="relative z-10 text-left">
                <div class="kirmizi-baslik">
                    Saha satış yönetim sistemi
                </div>

                <h1 class="h1-yazi max-w-xl">
                    Sahada satışınızı yönetin,
                    <span class="block text-red-600">işinizi hızlandırın.</span>
                </h1>

                <p class="mt-3 max-w-xl text-lg leading-8 text-slate-600 lg:mt-6">
                    BayMobil ile siparişten sevkiyata, stoktan raporlamaya kadar
                    tüm operasyonlarınızı sahada hızlı ve hatasız yönetin.
                </p>

                <div class="mt-5 flex flex-row items-center gap-5 lg:mt-10">
                    <a href="#"
                       class="rounded-btn-red inline-flex gap-3">
                        Hemen İndir
                        <span class="text-xl">↗</span>
                    </a>

                    <a href="#"
                       class="rounded-btn-white">
                        <span class="flex h-6 w-6 items-center justify-center rounded-full border border-slate-600 text-xs">
                            <icon name="play" class="h-4 w-4 text-black"></icon>
                        </span>
                        Demo İncele
                    </a>
                </div>

                <div class="mt-6 grid max-w-xl grid-cols-1 gap-4 lg:mt-12 lg:grid-cols-3 lg:gap-6">
                    <div class="flex items-start gap-3">
                        <div class="mt-1 flex h-6 w-6 items-center justify-center rounded-full border-2 border-red-600 text-red-600">
                            ✓
                        </div>
                        <div>
                            <h3 class="font-bold text-slate-800">Hızlı</h3>
                            <p class="text-sm text-slate-500">Kolay Kullanım</p>
                        </div>
                    </div>

                    <div class="flex items-start gap-3">
                        <div class="mt-1 flex h-6 w-6 items-center justify-center rounded-full border-2 border-red-600 text-red-600">
                            ✓
                        </div>
                        <div>
                            <h3 class="font-bold text-slate-800">Güvenilir</h3>
                            <p class="text-sm text-slate-500">Hatasız İşlem</p>
                        </div>
                    </div>

                    <div class="flex items-start gap-3">
                        <div class="mt-1 flex h-6 w-6 items-center justify-center rounded-full border-2 border-red-600 text-red-600">
                            ✓
                        </div>
                        <div>
                            <h3 class="font-bold text-slate-800">Anlık</h3>
                            <p class="text-sm text-slate-500">Doğru Veriye Erişim</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Sağ Telefon Görselleri -->
            <div class="relative flex items-center justify-center">

                <!-- Arka blur -->
                <div class="absolute right-6 top-8 h-72 w-72 rounded-full bg-red-200/60 blur-3xl"></div>

                <!-- Nokta desen -->
                <div class="absolute right-0 top-0 gap-1">
                    <div class="grid grid-cols-4 gap-2">
                        @for (int i = 0; i < 24; i++)
                        {
                            <span class="h-1.5 w-1.5 rounded-full bg-red-200"></span>
                        }
                    </div>
                </div>

                @* <img src="/images/phones.png"
                     alt="BayMobil uygulama ekranları"
                     class="relative drop-shadow-2xl" /> *@

                <div class="relative mx-auto mt-10 h-[360px] w-full max-w-[360px] overflow-visible lg:mt-20 lg:h-[560px] lg:max-w-[560px]">

                    <img src="/images/phone-left.png"
                         class="phone phone-left" />

                    <img src="/images/phone-center.png"
                         class="phone phone-center" />

                    <img src="/images/phone-right.png"
                         class="phone phone-right" />
                </div>

            </div>
