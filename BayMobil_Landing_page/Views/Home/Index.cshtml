<script>
    $(function () {
        $(".phone-hover").hover(
            function () {
                $(this).stop().animate({
                    bottom: "0px"
                }, 300);
            },
            function () {
                $(this).stop().animate({
                    bottom: "-36px"
                }, 300);
            }
        );
    });

    $(function () {
        setInterval(function () {
            $(".phone").each(function () {
                if ($(this).hasClass("phone-center")) {
                    $(this).removeClass("phone-center").addClass("phone-left");
                }
                else if ($(this).hasClass("phone-right")) {
                    $(this).removeClass("phone-right").addClass("phone-center");
                }
                else if ($(this).hasClass("phone-left")) {
                    $(this).removeClass("phone-left").addClass("phone-right");
                }
            });
        }, 3000);
    });
</script>
